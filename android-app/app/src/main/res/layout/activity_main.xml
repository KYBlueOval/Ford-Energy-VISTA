<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@drawable/bg_vista_dashboard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="700dp"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="28dp"
            android:paddingRight="20dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Ford Energy VISTA"
                android:elevation="10dp"
                android:src="@drawable/ic_vista" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="FORD ENERGY"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:text="@string/vista_title"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="@string/vista_expansion"
                android:textColor="#A9D9F4"
                android:textSize="8sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/networkStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_vista_status"
                    android:text="● Connected"
                    android:textColor="@color/vista_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dashboardNfcStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_vista_status"
                    android:text="NFC ready"
                    android:textColor="@color/vista_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_vista_card"
                android:elevation="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="MOBILE OPERATIONS"
                    android:textColor="@color/vista_orange"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Select a VISTA workspace"
                    android:textColor="@color/vista_ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="13dp"
                    android:text="Secure access uses your existing VISTA badge or username and PIN. NFC scans are delivered directly to the active workflow."
                    android:textColor="@color/vista_muted"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <Button android:id="@+id/openSecurity" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="8dp" android:background="@drawable/bg_vista_button" android:gravity="center_vertical|start" android:paddingHorizontal="18dp" android:text="SECURITY OPERATIONS  →&#10;NFC check-in, badges, incidents and handoffs" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                <Button android:id="@+id/openSponsor" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="10dp" android:background="@drawable/bg_vista_button" android:gravity="center_vertical|start" android:paddingHorizontal="18dp" android:text="SPONSOR &amp; APPROVER  →&#10;Visitor decisions, delegation and oversight" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                <Button android:id="@+id/openAdmin" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="10dp" android:background="@drawable/bg_vista_button" android:gravity="center_vertical|start" android:paddingHorizontal="18dp" android:text="SYSTEM ADMINISTRATION  →&#10;Users, alerts, reports, badges and governance" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                <Button android:id="@+id/openRegistration" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="10dp" android:background="@drawable/bg_vista_button" android:gravity="center_vertical|start" android:paddingHorizontal="18dp" android:text="VISITOR REGISTRATION  →&#10;Camera-enabled pre-arrival intake" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                <Button android:id="@+id/openEv" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="10dp" android:background="@drawable/bg_vista_button" android:gravity="center_vertical|start" android:paddingHorizontal="18dp" android:text="EV CHARGING ACCESS  →&#10;Employee vehicle charging request" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="FORD ENERGY V • I • S • T • A\nANDROID OPERATIONS CLIENT · VERSION 2.7.0"
                android:textColor="#45677F"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_vista_toolbar"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="7dp">

            <Button android:id="@+id/navBack" style="?android:attr/borderlessButtonStyle" android:layout_width="44dp" android:layout_height="48dp" android:text="‹" android:textColor="#FFFFFF" android:textSize="29sp" />
            <Button android:id="@+id/navHome" style="?android:attr/borderlessButtonStyle" android:layout_width="48dp" android:layout_height="48dp" android:text="⌂" android:textColor="#FFFFFF" android:textSize="22sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="7dp">
                <TextView android:id="@+id/moduleTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="VISTA" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/moduleSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="FORD ENERGY MOBILE OPERATIONS" android:textColor="#A9D9F4" android:textSize="8sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/nfcStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="5dp" android:text="NFC" android:textColor="#C8F1FF" android:textSize="9sp" android:textStyle="bold" />
            <Button android:id="@+id/navRefresh" style="?android:attr/borderlessButtonStyle" android:layout_width="44dp" android:layout_height="48dp" android:text="↻" android:textColor="#FFFFFF" android:textSize="21sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pageProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="@color/vista_sky"
            android:visibility="gone" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="match_parent" />
            <LinearLayout android:id="@+id/offlinePanel" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F2F8FC" android:gravity="center" android:orientation="vertical" android:padding="30dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connection unavailable" android:textColor="@color/vista_ink" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="VISTA requires a secure internet connection. Check Wi-Fi or mobile data, then retry." android:textColor="@color/vista_muted" android:textSize="13sp" />
                <Button android:id="@+id/offlineRetry" android:layout_width="220dp" android:layout_height="54dp" android:layout_marginTop="20dp" android:background="@drawable/bg_vista_button" android:text="Retry Connection" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
